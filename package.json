{
  "name": "chocolate-desktop-single",
  "version": "1.0.0",
  "description": "可可与嫑嫑甜点工坊 - 单机版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "author": "Yukea",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.yukea.chocolate",
    "productName": "可可巧克力工坊",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/.bin"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yukeaC",
        "repo": "https://github.com/yukeaC/chocolate-game",
        "releaseType": "release"
      }
    ]
  }
}