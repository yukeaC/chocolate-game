{
  "name": "chocolate-game",
  "version": "1.0.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.yukea.chocolate",
    "productName": "可可的巧克力工坊",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "chocolate-game-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yukeaC",
        "repo": "chocolate-game",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "electron-updater": "^6.1.1"
  }
}